# Copy to `.env.local` and fill with your Supabase project values.
# Both variables are required. Get them from:
#   https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Opcional — encurtador próprio (rastreio Fase 3). Sem domínio estável
# definido pelo Daniel, deixe vazio: o QR/link publicado usa a URL completa
# com UTM. Não inventar domínio. Ex.: https://go.exemplo.com.br
# VITE_SHORTENER_BASE=
